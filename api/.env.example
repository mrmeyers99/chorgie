# Required
DATABASE_URL=postgresql://user:password@host:5432/chorgie
JWT_SECRET=change-me-to-a-long-random-secret

# The origin of the web frontend (used for CORS).
# Example: https://chorgie.onrender.com
CORS_ORIGIN=http://localhost:5173

# Optional trust proxy setting for deployments behind load balancers/reverse proxies.
# Examples: true, 1, loopback, linklocal, uniquelocal
# TRUST_PROXY=true

# Optional – defaults to 3000
# PORT=3000
